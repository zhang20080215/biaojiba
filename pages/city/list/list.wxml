<!-- 全国旅游城市列表页（左省份 / 右城市 两栏布局；纯色文字，无封面图） -->
<view class="page-root" style="--brand-primary:{{cfg.brandPrimary}};--brand-soft:{{cfg.brandSoft}};--brand-rgb:{{cfg.shadowRgb}};--shadow-cta: 0 6rpx 14rpx rgba({{cfg.shadowRgb}}, 0.28);">

  <!-- 紧凑头部 -->
  <view class="hero-compact">
    <view class="hero-row">
      <text class="app-name">{{cfg.title}}</text>
      <text class="hero-percent">{{visitedProgressText}}</text>
    </view>
    <view class="hero-progress-bar"><view class="hero-progress-fill" style="width: {{visitedProgressWidth}};"></view></view>
    <text class="hero-sub">已打卡 {{visitedCount}}/{{allCount}} · {{cfg.slogan}}</text>
  </view>

  <!-- 搜索 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" value="{{searchKeyword}}" placeholder="搜索城市 / 省份" placeholder-class="search-ph" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchInput" />
      <view wx:if="{{searchKeyword}}" class="search-clear" catchtap="onSearchClear">✕</view>
    </view>
  </view>

  <!-- Tab + 操作 -->
  <view class="tabs-bar">
    <view class="tab {{activeTab === 0 ? 'active' : ''}}" data-idx="0" bindtap="onTabChange">全部({{allCount}})</view>
    <view class="tab {{activeTab === 1 ? 'active' : ''}}" data-idx="1" bindtap="onTabChange">去过({{visitedCount}})</view>
    <view class="tab {{activeTab === 2 ? 'active' : ''}}" data-idx="2" bindtap="onTabChange">想去({{wishCount}})</view>
    <view class="tab {{activeTab === 3 ? 'active' : ''}}" data-idx="3" bindtap="onTabChange">未去({{unvisitedCount}})</view>
  </view>

  <view class="action-row">
    <view wx:if="{{userInfo}}" class="batch-options">
      <block wx:if="{{!isBatchEditing}}">
        <view class="icon-btn batch-icon" bindtap="onStartBatchEdit">批量标记</view>
      </block>
      <block wx:elif="{{isBatchEditing}}">
        <view class="icon-btn action-watched" bindtap="onBatchVisited">去过</view>
        <view class="icon-btn action-wish" bindtap="onBatchWish">想去</view>
        <view class="icon-btn action-unwatched" bindtap="onBatchUnvisited">未去</view>
        <view class="icon-btn action-cancel" bindtap="onCancelBatchEdit">取消</view>
      </block>
    </view>
    <view class="generate-card-wrapper" bindtap="onShareTap" wx:if="{{!isBatchEditing}}">
      <view class="generate-card-btn">生成城市地图</view>
    </view>
  </view>

  <!-- 两栏：左省份 / 右城市 -->
  <view class="two-col">
    <scroll-view scroll-y class="prov-rail" enhanced show-scrollbar="{{false}}">
      <view class="rail-item {{currentProvince === '' && !searchKeyword ? 'active' : ''}}" data-province="" bindtap="onProvinceTap">全部</view>
      <view
        wx:for="{{provinces}}"
        wx:key="*this"
        class="rail-item {{currentProvince === item ? 'active' : ''}}"
        data-province="{{item}}"
        bindtap="onProvinceTap"
      >{{item}}</view>
    </scroll-view>

    <scroll-view scroll-y class="city-col" bindscrolltolower="loadMoreSpots" lower-threshold="120">
      <block wx:for="{{spots}}" wx:key="_id">
        <view class="city-row {{markStatusMap[item._id] === 'watched' ? 'row-visited' : ''}}" bindtap="{{isBatchEditing ? 'onSpotCheck' : ''}}" data-id="{{item._id}}">
          <view wx:if="{{isBatchEditing}}" class="batch-checkbox-wrap">
            <checkbox class="batch-checkbox" value="{{item._id}}" checked="{{item.checked}}" catchtap="onSpotCheck" data-id="{{item._id}}" />
          </view>
          <view class="city-main">
            <text class="city-name">{{item.shortName}}</text>
            <text wx:if="{{searchKeyword || currentProvince === ''}}" class="city-prov">{{item.province}}</text>
          </view>
          <view class="city-action" wx:if="{{!isBatchEditing}}">
            <block wx:if="{{markStatusMap[item._id] === 'watched'}}">
              <view class="mark-tag watched" data-id="{{item._id}}" catchtap="onOpenMarkSheet">去过 ▾</view>
            </block>
            <block wx:elif="{{markStatusMap[item._id] === 'wish'}}">
              <view class="mark-tag wish" data-id="{{item._id}}" catchtap="onOpenMarkSheet">想去 ▾</view>
            </block>
            <block wx:else>
              <view class="mark-btn mark-btn-wish" data-id="{{item._id}}" data-type="wish" catchtap="onMarkTap">想去</view>
              <view class="mark-btn" data-id="{{item._id}}" data-type="watched" catchtap="onMarkTap">去过</view>
            </block>
          </view>
        </view>
      </block>

      <view wx:if="{{!dataLoaded}}" class="empty-tip">城市数据加载中…</view>
      <view wx:elif="{{spots.length === 0}}" class="empty-tip">
        <text wx:if="{{searchKeyword}}">没有找到「{{searchKeyword}}」相关城市</text>
        <text wx:else>该分类下暂无城市</text>
      </view>
      <view wx:elif="{{hasMore}}" class="load-more-tip">上拉加载更多…</view>
      <view class="col-bottom-pad"></view>
    </scroll-view>
  </view>

  <view class="custom-toast {{customToastVisible ? 'show' : ''}}">
    <text class="custom-toast-text">{{customToast}}</text>
  </view>

  <!-- 标记纠正弹窗 -->
  <view class="mark-sheet-mask {{markSheetVisible ? 'show' : ''}}" catchtap="onCloseMarkSheet"></view>
  <view class="mark-sheet {{markSheetVisible ? 'show' : ''}}">
    <view class="mark-sheet-title">修改标记</view>
    <view class="mark-sheet-opt {{markSheetStatus === 'watched' ? 'active' : ''}}" data-status="watched" catchtap="onMarkSheetPick">
      <text class="mark-sheet-opt-text">去过</text>
      <text wx:if="{{markSheetStatus === 'watched'}}" class="mark-sheet-check">✓</text>
    </view>
    <view class="mark-sheet-opt {{markSheetStatus === 'wish' ? 'active' : ''}}" data-status="wish" catchtap="onMarkSheetPick">
      <text class="mark-sheet-opt-text">想去</text>
      <text wx:if="{{markSheetStatus === 'wish'}}" class="mark-sheet-check">✓</text>
    </view>
    <view class="mark-sheet-opt {{!markSheetStatus ? 'active' : ''}}" data-status="" catchtap="onMarkSheetPick">
      <text class="mark-sheet-opt-text">没去过</text>
      <text wx:if="{{!markSheetStatus}}" class="mark-sheet-check">✓</text>
    </view>
    <view class="mark-sheet-cancel" catchtap="onCloseMarkSheet">取消</view>
  </view>

  <!-- 个人信息授权弹窗 -->
  <view class="auth-modal" hidden="{{!showAuthModal}}">
    <view class="auth-mask" bindtap="onCancelAuth"></view>
    <view class="auth-content">
      <view class="auth-title">完善个人资料</view>
      <view class="auth-subtitle">请提供头像和昵称以获取更好的体验</view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="temp-avatar" src="{{tempAvatar || '/images/default-avatar.svg'}}" mode="aspectFill"></image>
        <view class="avatar-edit-tip">点击修改头像</view>
      </button>
      <view class="nickname-input-group">
        <text class="input-label">昵称</text>
        <input type="nickname" class="nickname-input" placeholder="请输入昵称" bindinput="onNicknameInput" bindblur="onNicknameInput" value="{{tempNickname}}" />
      </view>
      <view class="auth-actions">
        <button class="auth-btn cancel" bindtap="onCancelAuth">暂不登录</button>
        <button class="auth-btn confirm" bindtap="onConfirmAuth">保存并登录</button>
      </view>
    </view>
  </view>

</view>
