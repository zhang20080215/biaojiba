<view class="page-root">
  <view class="top-toast {{toast.show ? 'is-show' : ''}}">
    <text class="top-toast-icon" wx:if="{{toast.icon === 'success'}}">✓</text>
    <text class="top-toast-text">{{toast.text}}</text>
  </view>

  <view class="custom-nav" style="height: {{navOffset}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-btn nav-btn-left" bindtap="onBack" hover-class="nav-btn-active">
        <text class="nav-chev">‹</text>
      </view>
      <text class="nav-title">分享观影卡片</text>
    </view>
  </view>

  <!-- canvas 原生组件无法用 opacity 隐藏：backing store = 导出分辨率（computeSize），CSS 缩放到 previewW×previewH 显示，
       屏幕上这块 canvas 即预览图；导出的临时文件仅供「保存到相册」。 -->
  <view class="content" style="padding-top: {{navOffset}}px;">
    <!-- 顶部选项面板（首屏即渲染、不做 wx:if 增删，避开 canvas 相邻节点重建的坑）：
         单部 = 比例 + 评分开关；范围 = 范围(年度/月度 + 上下切换) + 版式 + 标题 + 背景 -->
    <view class="opt-panel">
      <block wx:if="{{singleMovie}}">
        <!-- 版式：utils/poster 注册表里已实现的 + 经典；只有经典时整行不出现 -->
        <view class="opt-row" wx:if="{{singleStyles.length > 1}}">
          <text class="opt-label">版式</text>
          <view class="mode-row">
            <view wx:for="{{singleStyles}}" wx:key="id"
                  class="mode-tab {{singleStyle === item.id ? 'is-active' : ''}}"
                  bindtap="onPickStyle" data-id="{{item.id}}">{{item.name}}</view>
          </view>
        </view>
        <!-- 背景深 / 浅：只对能切场景底的版式出现（杂志整幅封面、经典没有） -->
        <view class="opt-row" wx:if="{{stageOk}}">
          <text class="opt-label">背景</text>
          <view class="mode-row">
            <view class="mode-tab {{singleStage === 'dark' ? 'is-active' : ''}}" bindtap="onPickStage" data-id="dark">深色</view>
            <view class="mode-tab {{singleStage === 'light' ? 'is-active' : ''}}" bindtap="onPickStage" data-id="light">浅色</view>
          </view>
        </view>
        <!-- 比例只对经典（整幅封面）有意义：新版式都是固定 3:4 -->
        <view class="opt-row" wx:if="{{singleStyle === 'classic'}}">
          <text class="opt-label">比例</text>
          <view class="mode-row">
            <view class="mode-tab {{posterMode === 'xhs' ? 'is-active' : ''}}" bindtap="onPickMode" data-mode="xhs">小红书</view>
            <view class="mode-tab {{posterMode === 'raw' ? 'is-active' : ''}}" bindtap="onPickMode" data-mode="raw">原始海报</view>
          </view>
        </view>
        <view class="opt-row" wx:if="{{hasRatings}}">
          <text class="opt-label">评分</text>
          <view class="douban-row" bindtap="onToggleRatings">
            <view class="douban-switch {{hideRatings ? 'is-on' : ''}}"><view class="douban-knob"></view></view>
            <text class="douban-label">隐藏平台评分</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="opt-row">
          <text class="opt-label">范围</text>
          <view class="mode-row">
            <view class="mode-tab {{rangeMode === 'year' ? 'is-active' : ''}}" bindtap="onRangeMode" data-mode="year">年度</view>
            <view class="mode-tab {{rangeMode === 'month' ? 'is-active' : ''}}" bindtap="onRangeMode" data-mode="month">月度</view>
          </view>
          <view class="range-nav">
            <view class="range-arrow" bindtap="onPrevRange" hover-class="tap-soft">‹</view>
            <text class="range-label">{{rangeLabel}}</text>
            <view class="range-arrow {{canNextRange ? '' : 'is-disabled'}}" bindtap="onNextRange" hover-class="tap-soft">›</view>
          </view>
        </view>
        <view class="opt-row">
          <text class="opt-label">版式</text>
          <view class="mode-row">
            <view wx:for="{{rangeStyles}}" wx:key="id"
                  class="mode-tab {{rangeStyle === item.id ? 'is-active' : ''}}"
                  bindtap="onPickRangeStyle" data-id="{{item.id}}">{{item.name}}</view>
          </view>
        </view>
        <!-- 经典下才有的四种排法 -->
        <view class="opt-row" wx:if="{{rangeStyle === 'classic'}}">
          <text class="opt-label">排法</text>
          <view class="mode-row">
            <view class="mode-tab {{posterLayout === 'whole' ? 'is-active' : ''}}" bindtap="onPickLayout" data-layout="whole">整体</view>
            <view class="mode-tab {{posterLayout === 'month' ? 'is-active' : ''}}" bindtap="onPickLayout" data-layout="month">按月份</view>
            <view class="mode-tab {{posterLayout === 'rating' ? 'is-active' : ''}}" bindtap="onPickLayout" data-layout="rating">按评分</view>
            <!-- 日历：只在月度范围下出现 -->
            <view wx:if="{{calendarOk}}" class="mode-tab {{posterLayout === 'calendar' ? 'is-active' : ''}}" bindtap="onPickLayout" data-layout="calendar">日历</view>
          </view>
        </view>
        <view class="opt-row">
          <text class="opt-label">标题</text>
          <view class="title-row">
            <input class="title-input" value="{{customTitle}}" maxlength="{{titleMax}}" placeholder="留空用默认标题" placeholder-class="title-ph"
                   confirm-type="done" bindinput="onTitleInput" bindconfirm="onTitleCommit" bindblur="onTitleCommit" />
            <text class="title-count">{{customTitle.length}}/{{titleMax}}</text>
          </view>
        </view>
        <view class="opt-row" wx:if="{{stageOk}}">
          <text class="opt-label">背景</text>
          <view class="mode-row">
            <view class="mode-tab {{singleStage === 'dark' ? 'is-active' : ''}}" bindtap="onPickStage" data-id="dark">深色</view>
            <view class="mode-tab {{singleStage === 'light' ? 'is-active' : ''}}" bindtap="onPickStage" data-id="light">浅色</view>
          </view>
        </view>
        <!-- 小票、票夹、经典共用一套配色 -->
        <view class="opt-row">
          <text class="opt-label">配色</text>
          <view class="theme-row">
            <view wx:for="{{receiptPalettes}}" wx:key="id"
                  class="theme-chip {{receiptPalette === item.id ? 'is-active' : ''}}"
                  bindtap="onPickPalette" data-id="{{item.id}}">
              <view class="theme-dot" style="background: {{item.swatch}};"></view>
              <text class="theme-name">{{item.name}}</text>
            </view>
          </view>
        </view>
        <view class="opt-row" wx:if="{{rangeStyle === 'statement'}}">
          <text class="opt-label">文字</text>
          <view class="douban-row" bindtap="onToggleInk">
            <view class="douban-switch {{receiptInk ? 'is-on' : ''}}"><view class="douban-knob"></view></view>
            <text class="douban-label">油墨字（粗宋 + 铅印毛边）</text>
          </view>
        </view>
      </block>
    </view>

    <view class="preview-slot" style="height: {{slotH}}px;">
      <view class="preview-wrap" style="width: {{previewW}}px; height: {{previewH}}px;">
        <canvas type="2d" id="movieCard" class="poster-canvas" style="width: {{previewW}}px; height: {{previewH}}px;"></canvas>
      </view>
    </view>
    <text class="preview-tip">{{(loading || !ready) ? ' ' : (empty ? '这段时间还没有观影记录，换个范围试试' : '点下方「保存到相册」即可保存这张观影海报')}}</text>
  </view>

  <view class="action-bar">
    <button class="save-btn" bindtap="saveImage" disabled="{{isGenerating || !ready || empty}}" loading="{{isGenerating}}">
      {{isGenerating ? '保存中...' : '保存到相册'}}
    </button>
    <text wx:if="{{needRewardedAd && ready}}" class="save-sub">需观看广告后保存</text>
  </view>

  <!-- 页面级忙碌提示：固定在导航栏下方，切范围/版式时不用滚到底部也看得见。
       用 hidden 而不是 wx:if：节点常驻，避免与 canvas 同页反复增删节点。 -->
  <view class="busy-pill" hidden="{{!(loading || !ready)}}" style="top: {{navOffset + 12}}px;">
    <view class="busy-spin"></view>
    <text>{{loading ? '加载记录中…' : (coverText || '生成海报中…')}}</text>
  </view>
</view>
