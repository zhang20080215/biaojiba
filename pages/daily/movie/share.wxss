page {
  min-height: 100vh;
  background: #F4EEE2;
}
.page-root {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF7EF 0%, #F1E9DA 55%, #EBE1CF 100%);
  color: #2A2620;
  font-family: -apple-system, "PingFang SC", system-ui;
  box-sizing: border-box;
}
.top-toast {
  position: fixed;
  top: 22%;
  left: 50%;
  transform: translate(-50%, -8rpx);
  z-index: 1000;
  background: rgba(42, 38, 32, 0.9);
  color: #fff;
  padding: 18rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease, transform 220ms ease;
}
.top-toast.is-show { opacity: 1; transform: translate(-50%, 0); }

.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 20;
  background: #FBF7EF;
  box-sizing: border-box;
}
.nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title { font-size: 34rpx; font-weight: 700; color: #2A2620; }
.nav-btn {
  position: absolute;
  top: 50%;
  width: 76rpx;
  height: 76rpx;
  margin-top: -38rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn-left { left: 22rpx; }
.nav-btn-active { background: rgba(42, 38, 32, 0.06); }
.nav-chev { font-size: 56rpx; font-weight: 300; line-height: 1; color: #2A2620; }

.content {
  min-height: 100vh;
  padding: 32rpx 32rpx 260rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;   /* 选项面板在顶部，预览随其后（按月份长图会撑高页面） */
}
.preview-slot {
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-wrap {
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 48rpx rgba(42, 38, 32, 0.16);
}
.poster-canvas { display: block; }
.preview-tip {
  display: block;
  margin-top: 22rpx;
  text-align: center;
  font-size: 23rpx;
  color: #9A9184;
}

/* 顶部选项面板：每行「标签 + 控件」，多部 = 版式/配色，单部 = 比例/评分 */
.opt-panel {
  width: 100%;
  margin-bottom: 28rpx;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 6rpx 20rpx rgba(42, 38, 32, 0.06);
  box-sizing: border-box;
}
.opt-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 10rpx 0;
}
.opt-row + .opt-row { border-top: 1rpx solid rgba(42, 38, 32, 0.06); }
.opt-label {
  flex: none;
  width: 96rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2A2620;
}

.mode-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: center;
  gap: 12rpx;
}
.mode-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #8C8474;
  background: #F0EADD;
  border: 1rpx solid transparent;
  transition: all 160ms ease;
}
.mode-tab.is-disabled { opacity: 0.4; }
.mode-tab.is-active {
  color: #B8873B;
  background: #FFFFFF;
  border-color: rgba(184, 135, 59, 0.5);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(42, 38, 32, 0.10);
}

/* 自定义标题：输入框 + 字数 */
.title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.title-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #F0EADD;
  font-size: 25rpx;
  color: #2A2620;
}
.title-ph { color: #B7AE9B; }
.title-count { flex: none; font-size: 22rpx; color: #9A9184; }

.douban-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 14rpx;
}
.douban-switch {
  position: relative;
  width: 72rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #D8CFBE;
  transition: background 160ms ease;
}
.douban-switch.is-on { background: #B8873B; }
.douban-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(42, 38, 32, 0.25);
  transition: transform 160ms ease;
}
.douban-switch.is-on .douban-knob { transform: translateX(32rpx); }
.douban-label { font-size: 25rpx; color: #8C8474; }

/* 背景色卡：色点(渐变) + 名称，对齐豆瓣 TOP250 海报页 */
.theme-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: center;
  gap: 12rpx;
}
.theme-chip {
  display: inline-flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid transparent;
  transition: all 160ms ease;
}
.theme-chip.is-active {
  background: #FFFFFF;
  border-color: rgba(184, 135, 59, 0.5);
  box-shadow: 0 6rpx 18rpx rgba(45, 45, 43, 0.08);
}
.theme-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.theme-name { font-size: 24rpx; color: #6B6356; }
.theme-chip.is-active .theme-name { color: #2A2620; font-weight: 600; }

/* 范围切换：‹ 2026年 › 靠右 */
.range-nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.range-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #6B6356;
}
.range-arrow.is-disabled { opacity: 0.25; }
.range-label {
  min-width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2620;
  font-variant-numeric: tabular-nums;
}
.tap-soft { background: rgba(42, 38, 32, 0.06); }

.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 50;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(251, 247, 239, 0.94);
  box-shadow: 0 -8rpx 24rpx rgba(42, 38, 32, 0.06);
  box-sizing: border-box;
}
.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  line-height: 1;
  border-radius: 26rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, 0.2);
}
.save-btn[disabled] {
  opacity: 0.55;
  color: #FFFFFF;
  background: #1A1A1A;
}
.save-sub {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9A9184;
}

/* 页面级忙碌提示（固定在导航栏下方居中） */
.busy-pill {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(42, 38, 32, 0.86);
  color: #FFFFFF;
  font-size: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 38, 32, 0.18);
  pointer-events: none;
}
.busy-spin {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #FFFFFF;
  animation: busy-rotate 800ms linear infinite;
}
@keyframes busy-rotate { to { transform: rotate(360deg); } }
