@import "./common.wxss";

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0 28rpx;
}
.hero-cap {
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.hero-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--text-primary, #2D2D2B);
}
.hero-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: var(--brand-accent, #526631);
}
.card.is-loading {
  opacity: 0.5;
}
