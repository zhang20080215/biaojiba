<view class="page-root {{themeClass}}">
  <view class="top-toast {{toast.show ? 'is-show' : ''}}">
    <text class="top-toast-text">{{toast.text}}</text>
  </view>

  <daily-nav title="{{title}}" fallback="/pages/daily/metric/index?theme={{themeId}}" />

  <view class="content">
    <view class="quote">
      <text class="quote-cap">{{cap}}</text>
      <view class="quote-main">
        <text class="quote-num">{{big}}</text><text class="quote-unit" wx:if="{{bigUnit}}">{{bigUnit}}</text>
        <text class="quote-chg" wx:if="{{change}}" style="color: {{changeColor}};">{{change}}</text>
      </view>
      <view class="ohlc" wx:if="{{ohlc.length}}">
        <view wx:for="{{ohlc}}" wx:key="k" class="ohlc-item"><text class="ohlc-k">{{item.k}}</text><text class="ohlc-v">{{item.v}}</text></view>
      </view>
      <text class="quote-note" wx:if="{{note}}">{{note}}</text>
    </view>

    <view class="card chart-card">
      <!-- 左：日 / 周 / 月；右：这张图的设置 -->
      <view class="chart-head">
        <view class="periods">
          <view wx:for="{{periods}}" wx:key="key" class="period {{period === item.key ? 'is-on' : ''}}" data-key="{{item.key}}" bindtap="onPeriod">{{item.label}}</view>
        </view>
        <view class="opts">
          <view class="opt-group">
            <view class="opt {{mode === 'candle' ? 'is-on' : ''}}" data-mode="candle" bindtap="onMode">{{period === 'day' ? '柱形' : '箱体'}}</view>
            <view class="opt {{mode === 'line' ? 'is-on' : ''}}" data-mode="line" bindtap="onMode">折线</view>
          </view>
          <view class="opt opt-single {{showMA ? 'is-on' : ''}}" bindtap="onToggleMA">均线</view>
        </view>
      </view>
      <kline-chart wx:if="{{!empty}}" candles="{{candles}}" period="{{period}}" mode="{{mode}}" visible="{{visible}}"
                   goal="{{goalPlot}}" showGoal="{{true}}" goalText="{{goalText}}" format="{{format}}" accent="{{accent}}" showMA="{{showMA}}"
                   bind:select="onSelect" />
      <view class="empty-tip" wx:if="{{empty && !loading}}">还没有数据</view>

      <!-- 读图说明：周 / 月箱体画一个小样，旁边逐条说清楚 -->
      <view class="legend" wx:if="{{legend && !empty}}">
        <view wx:if="{{legend.kind === 'box'}}" class="legend-box">
          <view class="legend-candles">
            <view class="mini-candle is-up"><view class="mini-wick"></view><view class="mini-body"></view></view>
            <view class="mini-candle is-down"><view class="mini-wick"></view><view class="mini-body"></view></view>
          </view>
          <view class="legend-rows">
            <view wx:for="{{legend.rows}}" wx:key="k" class="legend-row"><text class="legend-k">{{item.k}}</text><text class="legend-v">{{item.v}}</text></view>
          </view>
        </view>
        <text wx:else class="legend-text">{{legend.text}}</text>
        <text class="legend-text" wx:if="{{legend.ma}}">{{legend.ma}}</text>
        <text class="legend-tip">左右拖动看更早 · 点一下看某一{{period === 'day' ? '天' : period === 'week' ? '周' : '月'}}</text>
      </view>
    </view>

    <block wx:if="{{kpi.length}}">
      <text class="sec-title">{{sumTitle}}</text>
      <view class="kpi-grid">
        <view class="kpi-tile" wx:for="{{kpi}}" wx:key="label">
          <text class="kpi-label">{{item.label}}</text>
          <view><text class="kpi-value">{{item.value}}</text><text class="kpi-unit">{{item.unit}}</text></view>
          <text class="kpi-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
      </view>
    </block>

    <view class="card section" wx:if="{{monthDays.length}}">
      <text class="cal-title">{{calYear}}年{{calMonth}}月</text>
      <month-heatmap year="{{calYear}}" month="{{calMonth}}" days="{{monthDays}}" goal="{{goal}}" measure="{{measure}}" today="{{today}}" heat="{{heat}}"
                     showNav="{{false}}" selected="{{selectedDay}}" bind:select="onSelectDay" />
      <view class="selected-line" wx:if="{{selectedText}}">{{selectedText}}</view>
    </view>

    <view class="links">
      <view class="link-btn" bindtap="onGoYear" hover-class="link-hover">年度视图</view>
      <view class="link-btn" bindtap="onGoShare" hover-class="link-hover">生成海报</view>
    </view>
  </view>
</view>
