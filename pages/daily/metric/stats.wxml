<view class="page-root {{themeClass}}">
  <view class="top-toast {{toast.show ? 'is-show' : ''}}">
    <text class="top-toast-text">{{toast.text}}</text>
  </view>

  <daily-nav title="{{title}}" fallback="/pages/daily/metric/index?theme={{themeId}}" />

  <view class="content">
    <view class="quote">
      <text class="quote-cap">{{cap}}</text>
      <view class="quote-main">
        <text class="quote-num">{{big}}</text><text class="quote-unit" wx:if="{{bigUnit}}">{{bigUnit}}</text>
        <text class="quote-chg" wx:if="{{change}}" style="color: {{changeColor}};">{{change}}</text>
      </view>
      <!-- 第三行固定一行高：周 / 月 / 年放 最多·最少·累计，日放 目标说明 —— 切换时下面的内容不跟着上下跳 -->
      <view class="quote-sub">
        <view class="ohlc" wx:if="{{ohlc.length}}">
          <view wx:for="{{ohlc}}" wx:key="k" class="ohlc-item"><text class="ohlc-k">{{item.k}}</text><text class="ohlc-v">{{item.v}}</text></view>
        </view>
        <text class="quote-note" wx:elif="{{note}}">{{note}}</text>
      </view>
    </view>

    <view class="card chart-card">
      <!-- 左：日 / 周 / 月 / 年；右：这张图的设置 -->
      <view class="chart-head">
        <view class="periods">
          <view wx:for="{{periods}}" wx:key="key" class="period {{period === item.key ? 'is-on' : ''}}" data-key="{{item.key}}" bindtap="onPeriod">{{item.label}}</view>
        </view>
        <view class="opts">
          <view class="opt-group">
            <view wx:for="{{modes}}" wx:key="key" class="opt {{mode === item.key ? 'is-on' : ''}}" data-mode="{{item.key}}" bindtap="onMode">{{item.label}}</view>
          </view>
          <view class="opt opt-single {{showMA ? 'is-on' : ''}}" bindtap="onToggleMA">均线</view>
        </view>
      </view>
      <!-- 周 / 月 / 年的柱形、折线：看日均还是总数。用不上时只隐藏、仍占位，图表不跟着上下跳 -->
      <view class="chart-sub {{showAgg ? '' : 'is-hidden'}}">
        <text class="chart-sub-label">每{{period === 'week' ? '周' : period === 'year' ? '年' : '月'}}看</text>
        <view class="opt-group">
          <view wx:for="{{aggs}}" wx:key="key" class="opt {{agg === item.key ? 'is-on' : ''}}" data-agg="{{item.key}}" bindtap="onAgg">{{item.label}}</view>
        </view>
      </view>
      <kline-chart wx:if="{{!empty}}" candles="{{candles}}" period="{{period}}" mode="{{mode}}" value="{{chartValue}}" visible="{{visible}}"
                   goal="{{goalPlot}}" showGoal="{{showGoal}}" goalText="{{goalText}}" format="{{format}}" accent="{{accent}}" showMA="{{showMA}}"
                   bind:select="onSelect" />
      <view class="empty-tip" wx:if="{{empty && !loading}}">还没有数据</view>
    </view>

    <block wx:if="{{kpi.length}}">
      <text class="sec-title">{{sumTitle}}</text>
      <view class="kpi-grid">
        <view class="kpi-tile" wx:for="{{kpi}}" wx:key="label">
          <text class="kpi-label">{{item.label}}</text>
          <view><text class="kpi-value">{{item.value}}</text><text class="kpi-unit">{{item.unit}}</text></view>
          <text class="kpi-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
      </view>
    </block>

    <view class="links">
      <view class="link-btn" bindtap="onGoShare" hover-class="link-hover">生成海报</view>
    </view>
  </view>
</view>
