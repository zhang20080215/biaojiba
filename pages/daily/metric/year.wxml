<view class="page-root {{themeClass}}">
  <view class="top-toast {{toast.show ? 'is-show' : ''}}">
    <text class="top-toast-text">{{toast.text}}</text>
  </view>

  <daily-nav title="{{title}}" fallback="/pages/daily/metric/index?theme={{themeId}}" />

  <view class="content">
    <view class="period-nav">
      <view class="period-arrow {{canPrev ? '' : 'is-off'}}" bindtap="onPrev">‹</view>
      <text class="period-label">{{year}}年</text>
      <view class="period-arrow {{canNext ? '' : 'is-off'}}" bindtap="onNext">›</view>
    </view>

    <view class="hero">
      <text class="hero-cap">{{heroCap}}</text>
      <view><text class="hero-num">{{heroNum}}</text><text class="hero-unit">{{heroUnit}}</text></view>
      <text class="hero-sub" wx:if="{{heroSub}}">{{heroSub}}</text>
    </view>

    <view class="card {{loading ? 'is-loading' : ''}}">
      <year-heatmap year="{{year}}" days="{{days}}" goal="{{goal}}" measure="{{measure}}" today="{{today}}" heat="{{heat}}" />
    </view>

    <view class="kpi-grid">
      <view class="kpi-tile" wx:for="{{kpi}}" wx:key="label">
        <text class="kpi-label">{{item.label}}</text>
        <view><text class="kpi-value">{{item.value}}</text><text class="kpi-unit">{{item.unit}}</text></view>
      </view>
    </view>
  </view>
</view>
