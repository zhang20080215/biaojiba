@import "./common.wxss";

.headline {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 36rpx 0 28rpx;
}
.headline-cap {
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.headline-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--text-primary, #2D2D2B);
}
.headline-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.headline-sub {
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
}

.chart {
  position: relative;
  height: 320rpx;
  display: flex;
  align-items: flex-end;
  margin-top: 24rpx;
  border-bottom: 2rpx solid var(--line-subtle, #EAEAE7);
}
.chart.is-loading {
  opacity: 0.4;
}
.goal-line {
  position: absolute;
  left: 0;
  right: 0;
  border-top: 2rpx dashed var(--brand-accent, #526631);
  opacity: 0.6;
  z-index: 1;
}
.bar-col {
  flex: 1;
  height: 100%;
  padding: 0 3rpx;
  box-sizing: border-box;
}
.bar-track {
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 100%;
  max-width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
}
.bar-missing {
  width: 100%;
  max-width: 48rpx;
  height: 12rpx;
  border: 2rpx dashed var(--line-subtle, #EAEAE7);
  border-bottom: none;
  box-sizing: border-box;
}
.bar-labels {
  display: flex;
  margin-top: 8rpx;
}
.bar-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  white-space: nowrap;
  overflow: visible;
}
.chart-legend {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin-top: 16rpx;
}
.legend-line {
  width: 32rpx;
  border-top: 2rpx dashed var(--brand-accent, #526631);
  margin-right: 8rpx;
}
.legend-note {
  margin-left: auto;
}
