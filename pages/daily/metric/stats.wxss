@import "./common.wxss";

/* 表头学股票行情：时间段 → 大数字 + 涨跌 → 开收高低 */
.quote {
  margin: 32rpx 8rpx 24rpx;
}
.quote-cap {
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.quote-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 6rpx;
}
.quote-num {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary, #2D2D2B);
}
.quote-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.quote-chg {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--text-muted, #9C998F);
}
.ohlc {
  display: flex;
  margin-top: 12rpx;
}
.ohlc-item {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.ohlc-k {
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.ohlc-v {
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary, #2D2D2B);
}
.quote-note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
}

.chart-card {
  padding: 20rpx 20rpx 16rpx;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.chart-tip {
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
}
.modes {
  display: flex;
  gap: 8rpx;
}
.mode {
  padding: 6rpx 20rpx;
  border-radius: 99rpx;
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.mode.is-on {
  color: var(--brand-accent, #526631);
  background: var(--brand-tint, #EEF2E5);
  font-weight: 600;
}

.sec-title {
  display: block;
  margin: 32rpx 8rpx 0;
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.cal-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
