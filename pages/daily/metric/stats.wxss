@import "./common.wxss";

/* 表头学股票行情：时间段 → 大数字 + 涨跌 → 开收高低 */
.quote {
  margin: 32rpx 8rpx 24rpx;
}
.quote-cap {
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.quote-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 6rpx;
}
.quote-num {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary, #2D2D2B);
}
.quote-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.quote-chg {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--text-muted, #9C998F);
}
.ohlc {
  display: flex;
  margin-top: 12rpx;
}
.ohlc-item {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.ohlc-k {
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.ohlc-v {
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary, #2D2D2B);
}
.quote-note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
}

.chart-card {
  padding: 20rpx 20rpx 16rpx;
}
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
/* 日 / 周 / 月：图表左上，分段按钮 */
.periods {
  display: flex;
  background: var(--bg-section, #F5F5F4);
  border-radius: 99rpx;
  padding: 4rpx;
}
.period {
  min-width: 56rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 99rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
}
.period.is-on {
  background: var(--bg-card, #FFFFFF);
  color: var(--text-primary, #2D2D2B);
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}
/* 右侧设置：画法二选一 + 均线开关 */
.opts {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.opt-group {
  display: flex;
  border: 2rpx solid var(--line-subtle, #EAEAE7);
  border-radius: 99rpx;
  overflow: hidden;
}
.opt {
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.opt.is-on {
  color: var(--brand-accent, #526631);
  background: var(--brand-tint, #EEF2E5);
  font-weight: 600;
}
.chart-sub {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin: -4rpx 0 8rpx;
}
.chart-sub-label {
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.opt-single {
  border: 2rpx solid var(--line-subtle, #EAEAE7);
  border-radius: 99rpx;
}

/* 读图说明 */
.legend {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line-subtle, #EAEAE7);
}
.legend-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
/* 箱体图例：一个「十」字 —— 竖线 = 最少到最多，横线 = 平均 */
.mini-cross {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 100rpx;
  margin: 0 8rpx;
}
.mini-v {
  position: absolute;
  left: 19rpx;
  top: 0;
  bottom: 0;
  width: 3rpx;
  border-radius: 2rpx;
  background: var(--brand-accent, #526631);
}
.mini-h {
  position: absolute;
  left: 0;
  right: 0;
  top: 42rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--brand-accent, #526631);
}
.legend-rows {
  flex: 1;
  min-width: 0;
}
.legend-row {
  display: flex;
  font-size: 22rpx;
  line-height: 1.7;
}
.legend-k {
  flex-shrink: 0;
  width: 112rpx;
  color: var(--text-primary, #2D2D2B);
  font-weight: 600;
}
.legend-v {
  color: var(--text-secondary, #6F6F68);
}
.legend-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary, #6F6F68);
}
.legend-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
}

.sec-title {
  display: block;
  margin: 32rpx 8rpx 0;
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.cal-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
