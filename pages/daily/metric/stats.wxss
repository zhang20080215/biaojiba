@import "./common.wxss";

.headline {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 36rpx 0 28rpx;
}
.headline-cap {
  font-size: 24rpx;
  color: var(--text-muted, #9C998F);
}
.headline-num {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--text-primary, #2D2D2B);
}
.headline-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.headline-sub {
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
}

.chart {
  position: relative;
  height: 320rpx;
  display: flex;
  align-items: flex-end;
  margin-top: 24rpx;
  border-bottom: 2rpx solid var(--line-subtle, #EAEAE7);
}
.chart.is-loading {
  opacity: 0.4;
}
.goal-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 0;
  border-top: 2rpx dashed var(--brand-accent, #526631);
  z-index: 2;
}
/* 目标值贴在虚线右下角；虚线太低时 is-above 改贴右上角 */
.goal-label {
  position: absolute;
  right: 0;
  top: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--bg-card, #FFFFFF);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--brand-accent, #526631);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.goal-label.is-above {
  top: auto;
  bottom: 6rpx;
}
.line-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.chart-types {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 12rpx;
}
.chart-type {
  padding: 6rpx 20rpx;
  border-radius: 99rpx;
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
  border: 2rpx solid transparent;
}
.chart-type.is-on {
  color: var(--brand-accent, #526631);
  background: var(--brand-tint, #EEF2E5);
  font-weight: 600;
}
.bar-col {
  flex: 1;
  height: 100%;
  padding: 0 3rpx;
  box-sizing: border-box;
}
.bar-track {
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 100%;
  max-width: 48rpx;
  border-radius: 8rpx 8rpx 0 0;
}
.bar-missing {
  width: 100%;
  max-width: 48rpx;
  height: 12rpx;
  border: 2rpx dashed var(--line-subtle, #EAEAE7);
  border-bottom: none;
  box-sizing: border-box;
}
.bar-labels {
  display: flex;
  margin-top: 8rpx;
}
.bar-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  white-space: nowrap;
  overflow: visible;
}
.chart-legend {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin-top: 16rpx;
}

