@import "./common.wxss";

.auth-card {
  margin-bottom: 24rpx;
  background: var(--brand-tint, #EEF2E5);
  box-shadow: none;
}
.auth-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-accent, #526631);
}
.auth-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
  margin: 8rpx 0 24rpx;
}

.today-card {
  display: flex;
  align-items: center;
}
.today-ring {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  flex-shrink: 0;
}
.ring-img {
  width: 300rpx;
  height: 300rpx;
}
.ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-cap {
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
}
.ring-num {
  font-size: 54rpx;
  font-weight: 800;
  color: var(--text-primary, #2D2D2B);
  margin: 4rpx 0;
}
.ring-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand-accent, #526631);
}
.today-side {
  flex: 1;
  min-width: 0;
  padding-left: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.goal-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: var(--brand-tint, #EEF2E5);
  color: var(--brand-accent, #526631);
  font-size: 22rpx;
  font-weight: 600;
}
.goal-edit {
  margin-left: 8rpx;
}
.pill-hover {
  opacity: 0.8;
}
.today-cheer {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #2D2D2B);
  margin-top: 20rpx;
  line-height: 1.4;
}
.today-eq {
  font-size: 24rpx;
  color: var(--text-secondary, #6F6F68);
  margin-top: 8rpx;
}
.today-sync {
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin-top: 16rpx;
}
.today-sync.is-fail {
  color: #C0392B;
}

.selected-line {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md, 16rpx);
  background: var(--bg-section, #F5F5F4);
  font-size: 26rpx;
  color: var(--text-primary, #2D2D2B);
}

.entries {
  display: flex;
  justify-content: space-between;
}
.entry {
  width: calc(33.33% - 14rpx);
  background: var(--bg-card, #FFFFFF);
  border-radius: var(--radius-lg, 24rpx);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(0, 0, 0, 0.08));
}
.entry-hover {
  background: var(--brand-tint, #EEF2E5);
}
.entry-icon {
  font-size: 40rpx;
}
.entry-text {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: var(--text-primary, #2D2D2B);
}
.foot-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin-top: 28rpx;
}

/* 每日目标面板 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--bg-card, #FFFFFF);
  border-radius: var(--radius-xl, 32rpx) var(--radius-xl, 32rpx) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
}
.sheet-value {
  text-align: center;
  margin: 24rpx 0 8rpx;
}
.sheet-num {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--brand-accent, #526631);
}
.sheet-unit {
  font-size: 26rpx;
  color: var(--text-secondary, #6F6F68);
  margin-left: 8rpx;
}
.sheet-range {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
  margin: 0 18rpx 32rpx;
}
