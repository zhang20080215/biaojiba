@import "../common.wxss";

.cl-intro {
  display: block;
  margin: 8rpx 4rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--cl-sub);
}

.cl-retry {
  color: var(--cl-brand);
  font-weight: 600;
}

.cl-card {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.cl-card-kind {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--cl-soft);
  color: var(--cl-brand);
  font-size: 22rpx;
  font-weight: 700;
}

.cl-card-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}
.cl-pressed {
  opacity: 0.8;
}

.cl-covers {
  flex: 0 0 auto;
  display: flex;
}
.cl-cover {
  width: 84rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #EEEBE3;
  margin-right: -28rpx;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.cl-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--cl-mute);
}

.cl-card-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-left: 40rpx;
}
.cl-card-title {
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cl-card-desc {
  font-size: 24rpx;
  color: #6F6F68;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cl-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 28rpx;
}

.cl-card-create {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
