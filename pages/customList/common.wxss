/* 自建影单 / 书单三页共用样式。--cl-brand / --cl-soft 由页面按类型内联注入 */
page {
  background: #FAF8F3;
}

.cl-page {
  --cl-brand: #526631;
  --cl-soft: #EEF2E5;
  --cl-ink: #2D2D2B;
  --cl-sub: #6F6F68;
  --cl-mute: #9C998F;
  --cl-line: #ECE8DE;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 200rpx;
  color: var(--cl-ink);
}

.cl-muted {
  font-size: 24rpx;
  color: var(--cl-mute);
}

.cl-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx;
  border-radius: 16rpx;
  background: var(--cl-brand);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}
.cl-btn-ghost {
  background: var(--cl-soft);
  color: var(--cl-brand);
}
.cl-btn-disabled {
  background: #E6E3DA;
  color: #B0AB9F;
}
.cl-btn:active {
  transform: scale(0.97);
}

/* 条目行：封面 + 标题 + 副信息 + 右侧操作 */
.cl-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--cl-line);
}
.cl-row-cover {
  flex: 0 0 auto;
  width: 84rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #EEEBE3;
}
.cl-row-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.cl-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cl-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cl-row-sub {
  font-size: 22rpx;
  color: var(--cl-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cl-row-action {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--cl-soft);
  color: var(--cl-brand);
}
.cl-row-action.done {
  background: transparent;
  color: var(--cl-mute);
  font-weight: 400;
}
.cl-check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #CFCABD;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}
.cl-check.on {
  background: var(--cl-brand);
  border-color: var(--cl-brand);
}
.cl-check.off {
  background: #EEEBE3;
  border-color: #EEEBE3;
}

/* 底部固定操作条 */
.cl-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(250, 248, 243, 0.96);
  border-top: 1rpx solid var(--cl-line);
}
.cl-bottom-info {
  flex: 1;
  font-size: 24rpx;
  color: var(--cl-sub);
}

.cl-empty {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--cl-mute);
  line-height: 1.7;
}
