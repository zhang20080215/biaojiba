<view class="cl-page ad-page" style="--cl-brand:{{meta.brand}};--cl-soft:{{meta.soft}}">
  <view class="ad-sticky">
    <view class="ad-tabs">
      <view class="ad-tab {{tab === 'rank' ? 'active' : ''}}" data-tab="rank" bindtap="onTab">从榜单挑</view>
      <view class="ad-tab {{tab === 'search' ? 'active' : ''}}" data-tab="search" bindtap="onTab">搜索{{meta.verb}}</view>
    </view>

    <block wx:if="{{tab === 'rank'}}">
      <scroll-view class="ad-sources" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{sources}}" wx:key="theme" class="ad-source {{activeSource === item.theme ? 'active' : ''}}" data-theme="{{item.theme}}" bindtap="onSourceTap">{{item.title}}</view>
      </scroll-view>
      <view class="ad-filter-row">
        <input class="ad-input" placeholder="在当前榜单里筛选{{meta.verb}}" value="{{rankFilter}}" bindinput="onRankFilter" confirm-type="search" />
        <text class="ad-link" bindtap="onSelectAllVisible" wx:if="{{rankItems.length}}">全选</text>
      </view>
    </block>

    <view wx:else class="ad-filter-row">
      <input class="ad-input" placeholder="输入{{meta.verb}}，搜索豆瓣" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" focus="{{tab === 'search'}}" />
      <view class="cl-btn ad-search-btn" bindtap="onSearch">{{searching ? '搜索中' : '搜索'}}</view>
    </view>
  </view>

  <!-- 榜单勾选 -->
  <block wx:if="{{tab === 'rank'}}">
    <view wx:if="{{rankLoading}}" class="cl-empty">正在读取榜单…</view>
    <view wx:elif="{{!rankItems.length}}" class="cl-empty">{{rankFilter ? '没有匹配的条目' : '这个榜单暂无数据'}}</view>
    <view wx:for="{{rankItems}}" wx:key="_id" class="cl-row" data-id="{{item._id}}" bindtap="onRankToggle">
      <view class="cl-check {{item.added ? 'off' : selectedMap[item._id] ? 'on' : ''}}">{{item.added || selectedMap[item._id] ? '✓' : ''}}</view>
      <image class="cl-row-cover" src="{{item.thumb}}" mode="aspectFill" lazy-load />
      <view class="cl-row-body">
        <text class="cl-row-title">{{item.rank}}. {{item.title}}</text>
        <text class="cl-row-sub">{{item.added ? '已在清单' : item.sub}}</text>
      </view>
    </view>
  </block>

  <!-- 搜索结果 -->
  <block wx:else>
    <view wx:if="{{searching}}" class="cl-empty">正在搜索…</view>
    <view wx:elif="{{searched && !results.length}}" class="cl-empty">没有搜到，换个关键词试试</view>
    <view wx:elif="{{!searched}}" class="cl-empty">榜单里没有的{{meta.item}}，可以在这里按{{meta.verb}}搜索加入</view>
    <view wx:for="{{results}}" wx:key="doubanId" class="cl-row">
      <image class="cl-row-cover" src="{{item.thumb}}" mode="aspectFill" lazy-load referrer-policy="no-referrer" />
      <view class="cl-row-body">
        <text class="cl-row-title">{{item.title}}</text>
        <text class="cl-row-sub">{{item.sub}}</text>
      </view>
      <view wx:if="{{item.added}}" class="cl-row-action done">已加入</view>
      <view wx:else class="cl-row-action" data-id="{{item.doubanId}}" bindtap="onAddSearchItem">{{addingId === item.doubanId ? '加入中' : '+ 加入'}}</view>
    </view>
  </block>

  <view class="cl-bottom">
    <text class="cl-bottom-info">清单 {{count}} / 200，还能加 {{room}} {{meta.unit}}</text>
    <view wx:if="{{tab === 'rank'}}" class="cl-btn {{selectedCount ? '' : 'cl-btn-disabled'}}" bindtap="onAddSelected">加入{{selectedCount ? '（' + selectedCount + '）' : ''}}</view>
  </view>
</view>
