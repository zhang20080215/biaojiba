/* 海报预览页：框架/配色对齐豆瓣电影海报页（pages/genericList/share） */
.share-page {
  min-height: 100vh;
  position: relative;
  background: #FFFCF5;
  box-sizing: border-box;
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}

/* ── 顶部 ── */
.immersive-top {
  padding-left: var(--space-3);
  padding-right: var(--space-3);
  padding-bottom: var(--space-2);
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(45, 45, 43, 0.06);
}
.top-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.top-right {
  width: 56rpx;
  height: 56rpx;
}

/* ── 面板（版式 / 配色） ── */
.bg-panel {
  margin-top: var(--space-2);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-xl);
  background: #F8F3E7;
  border: 1rpx solid rgba(237, 231, 218, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(45, 45, 43, 0.05);
}
.bg-panel-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: var(--space-2);
  flex: 0 0 auto;
}

.theme-scroll {
  flex: 0 1 auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.theme-chip {
  display: inline-flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid transparent;
  transition: transform 120ms ease-out, box-shadow 120ms ease-out, border-color 120ms ease-out;
}
.theme-chip.active {
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(45, 45, 43, 0.08);
  border-color: rgba(182, 202, 235, 0.95);
  transform: translateY(-1rpx);
}
.theme-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.theme-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.theme-check {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #6A89B6;
  line-height: 1;
}

/* 版式 toggle */
.style-toggle {
  display: flex;
  gap: 12rpx;
}
.style-chip {
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid transparent;
  transition: transform 120ms ease-out, box-shadow 120ms ease-out, border-color 120ms ease-out;
}
.style-chip.active {
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(45, 45, 43, 0.08);
  border-color: rgba(182, 202, 235, 0.95);
  transform: translateY(-1rpx);
}
.style-chip-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ── 预览区 ── */
.content-wrap {
  padding: 0 var(--space-3);
}
.loading-tip {
  text-align: center;
  color: #9C998F;
  font-size: 26rpx;
  padding: 40rpx 0 10rpx;
}
.poster-wrap {
  position: relative;
  margin: var(--space-3) auto 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 14rpx 44rpx rgba(45, 45, 43, 0.16);
  background: #F5F3EE;
  opacity: 0.55;
  transition: opacity 220ms ease-out;
}
.poster-wrap.shown { opacity: 1; }
.poster-canvas { display: block; }
.poster-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9C998F;
  font-size: 26rpx;
  background: rgba(245, 243, 238, 0.5);
}

/* ── 底部保存栏 ── */
.save-btn-container {
  position: fixed;
  left: var(--space-3);
  right: var(--space-3);
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
}
.save-btn {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-pill);
  background: #2E8B72;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.3;
  box-shadow: 0 6rpx 16rpx rgba(46, 139, 114, 0.32);
}
.save-btn::after { border: none; }
.save-btn[disabled] { opacity: 0.5; }
.save-btn-main { font-size: 30rpx; font-weight: 700; }
.save-btn-sub { font-size: 20rpx; opacity: 0.9; margin-top: 2rpx; }
