<view wx:if="{{!view}}" class="dg dg-empty" bindtap="onCreate" hover-class="dg-hover">
  <view class="dg-empty-main">
    <text class="dg-empty-title">设一个累计目标</text>
    <text class="dg-empty-sub" wx:if="{{example}}">比如：{{example}}</text>
  </view>
  <text class="dg-plus">＋</text>
</view>

<view wx:else class="dg">
  <view class="dg-head">
    <view class="dg-head-main">
      <text class="dg-cap">累计目标 · {{view.range}}</text>
      <text class="dg-title">{{view.title}}</text>
    </view>
    <text wx:if="{{view.status === 'active'}}" class="dg-link" bindtap="onEdit">调整</text>
  </view>

  <view class="dg-bar"><view class="dg-bar-fill" style="width: {{view.pct}}%;"></view></view>

  <block wx:if="{{view.status === 'active'}}">
    <view class="dg-row">
      <text class="dg-strong">{{view.walkedText}}</text><text class="dg-muted"> {{unit}} · {{view.pct}}%</text>
      <text class="dg-right dg-muted">还差 {{view.remainingText}} {{unit}}</text>
    </view>
    <view class="dg-tip">{{view.tip}}</view>
  </block>

  <block wx:elif="{{view.status === 'done'}}">
    <view class="dg-result">
      <text class="dg-result-title">🎉 目标达成</text>
      <text class="dg-muted">用了 {{view.usedDays}} 天，{{verb}}满 {{view.walkedText}} {{unit}}</text>
    </view>
    <view class="dg-btn" bindtap="onRestart" hover-class="dg-hover">再设一个</view>
  </block>

  <block wx:else>
    <view class="dg-result">
      <text class="dg-result-title">目标已到期</text>
      <text class="dg-muted">完成了 {{view.pct}}%，共 {{view.walkedText}} {{unit}}</text>
    </view>
    <view class="dg-btn" bindtap="onRestart" hover-class="dg-hover">再设一个</view>
  </block>
</view>
