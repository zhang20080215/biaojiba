<view class="mh">
  <view class="mh-nav">
    <view class="mh-arrow {{canPrev ? '' : 'is-off'}}" bindtap="onPrev" hover-class="mh-arrow-hover">‹</view>
    <text class="mh-label">{{label}}</text>
    <view class="mh-arrow {{canNext ? '' : 'is-off'}}" bindtap="onNext" hover-class="mh-arrow-hover">›</view>
  </view>
  <view class="mh-head">
    <text wx:for="{{weekHeader}}" wx:key="*this" class="mh-head-cell">{{item}}</text>
  </view>
  <view class="mh-grid {{loading ? 'is-loading' : ''}}">
    <block wx:for="{{cells}}" wx:key="key">
      <view wx:if="{{item.empty}}" class="mh-cell"></view>
      <view wx:else class="mh-cell" data-date="{{item.date}}" data-future="{{item.isFuture}}" bindtap="onTap">
        <view class="mh-box {{item.level === -1 ? 'is-missing' : ''}} {{item.isFuture ? 'is-future' : ''}} {{item.isToday ? 'is-today' : ''}} {{selected === item.date ? 'is-selected' : ''}}"
              style="{{item.bg ? 'background:' + item.bg + ';' : ''}}">
          <text class="mh-day {{item.light ? 'is-light' : ''}}">{{item.day}}</text>
          <text wx:if="{{item.achieved}}" class="mh-check">✓</text>
        </view>
      </view>
    </block>
  </view>
  <view class="mh-legend">
    <text class="mh-legend-text">少</text>
    <view wx:for="{{heat}}" wx:key="*this" class="mh-legend-dot" style="background: {{item}};"></view>
    <text class="mh-legend-text">多</text>
    <view class="mh-legend-dot is-missing"></view>
    <text class="mh-legend-text">无数据</text>
  </view>
</view>
