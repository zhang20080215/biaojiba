.mh-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mh-arrow {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-primary, #2D2D2B);
}
.mh-arrow.is-off {
  color: var(--line-subtle, #EAEAE7);
}
.mh-arrow-hover {
  background: var(--brand-tint, #EEF2E5);
}
.mh-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #2D2D2B);
}
.mh-head,
.mh-grid {
  display: flex;
  flex-wrap: wrap;
}
.mh-head-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted, #9C998F);
  padding-bottom: 8rpx;
}
.mh-grid.is-loading {
  opacity: 0.5;
}
.mh-cell {
  width: 14.2857%;
  padding: 5rpx;
  box-sizing: border-box;
}
.mh-box {
  position: relative;
  height: 80rpx;
  border-radius: var(--radius-sm, 12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.mh-box.is-missing {
  border: 2rpx dashed var(--line-subtle, #EAEAE7);
}
.mh-box.is-today {
  box-shadow: 0 0 0 3rpx var(--brand-accent, #526631);
}
.mh-box.is-selected {
  box-shadow: 0 0 0 3rpx var(--text-primary, #2D2D2B);
}
.mh-day {
  font-size: 24rpx;
  color: var(--text-primary, #2D2D2B);
}
.mh-day.is-light {
  color: #FFFFFF;
  font-weight: 600;
}
.mh-box.is-future .mh-day,
.mh-box.is-missing .mh-day {
  color: var(--text-muted, #9C998F);
}
.mh-check {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #FFFFFF;
}
.mh-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.mh-legend-text {
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin: 0 8rpx;
}
.mh-legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 5rpx;
  margin-right: 4rpx;
  box-sizing: border-box;
}
.mh-legend-dot.is-missing {
  margin-left: 16rpx;
  border: 2rpx dashed var(--text-muted, #9C998F);
}
