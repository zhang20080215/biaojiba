.yh-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}
.yh-label {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
}
.yh-cells {
  flex: 1;
  display: flex;
}
/* 31 列：每格 = (100% - 30 个 3rpx 间隙) / 31 */
.yh-cells .yh-cell {
  width: calc((100% - 90rpx) / 31);
  margin-right: 3rpx;
}
.yh-cells .yh-cell:last-child {
  margin-right: 0;
}
.yh-cell {
  height: 18rpx;
  width: 18rpx;
  border-radius: 4rpx;
  box-sizing: border-box;
}
.yh-cell.is-missing {
  border: 1rpx dashed var(--text-muted, #9C998F);
  opacity: 0.6;
}
.yh-cell.is-future {
  background: var(--bg-section, #F5F5F4);
}
.yh-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.yh-legend .yh-cell {
  margin-right: 4rpx;
}
.yh-legend .yh-gap {
  margin-left: 16rpx;
}
.yh-legend-text {
  font-size: 20rpx;
  color: var(--text-muted, #9C998F);
  margin: 0 8rpx;
}
