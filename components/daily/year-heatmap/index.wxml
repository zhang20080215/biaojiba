<view class="yh">
  <view wx:for="{{rows}}" wx:for-item="row" wx:key="month" class="yh-row">
    <text class="yh-label">{{row.label}}</text>
    <view class="yh-cells">
      <view wx:for="{{row.cells}}" wx:key="key" class="yh-cell {{item.cls}}" style="{{item.bg ? 'background:' + item.bg + ';' : ''}}"></view>
    </view>
  </view>
  <view class="yh-legend">
    <text class="yh-legend-text">少</text>
    <view wx:for="{{heat}}" wx:key="*this" class="yh-cell" style="background: {{item}};"></view>
    <text class="yh-legend-text">多</text>
    <view class="yh-cell is-missing yh-gap"></view>
    <text class="yh-legend-text">无数据</text>
  </view>
</view>
