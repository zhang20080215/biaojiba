.hub-root .hub-personal-tabs button { flex: 1; width: 0; padding: 8rpx 0; border-radius: 0; background: transparent; color: var(--text-secondary); white-space: nowrap; position: relative; }
.hub-root .hub-personal-tabs button.hub-chip-active { color: var(--hub-accent); }
.hub-personal-tabs .hub-chip-active::before { content: ''; position: absolute; bottom: 0; left: 28%; right: 28%; height: 5rpx; border-radius: 4rpx; background: var(--hub-accent); }
