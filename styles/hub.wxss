.timeline-intro > view { min-width: 0; }
.timeline-item + .timeline-item { border-top: 1rpx solid var(--line-subtle); }
.timeline-item > .timeline-placeholder { flex: 0 0 64rpx; width: 64rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; background: var(--hub-soft); border-radius: 8rpx; font-size: 28rpx; }
.timeline-status { display: inline-block; font-size: 22rpx; line-height: 1.5; margin-top: 6rpx; color: var(--hub-accent); }
.timeline-status-wish { color: var(--text-secondary); }
.hub-root button.timeline-history { display: block; margin: 8rpx auto 24rpx; padding: 0 12rpx; color: var(--text-secondary); }
@media (max-width: 340px) {
  .hub-root { --hub-gutter: 24rpx; }
