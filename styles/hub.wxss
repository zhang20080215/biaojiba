.timeline-item-title { display: block; font-size: 25rpx; line-height: 1.5; overflow-wrap: anywhere; }
.hub-root button.timeline-source { padding: 18rpx 0 0; margin-top: 16rpx; width: 100%; min-height: 44px; font-size: 24rpx; line-height: 1.6; text-align: left; white-space: normal; background: transparent; color: var(--hub-accent); border-top: 1rpx solid var(--line-subtle); }
.hub-root button.timeline-more { margin: 12rpx auto 24rpx; }

/* Compact controls and shared surfaces; keep pastel fills separate from readable text. */
.hub-filter-scroll { width: 100%; white-space: nowrap; }
.hub-root button.hub-search-clear { background: transparent; color: var(--hub-accent); }
