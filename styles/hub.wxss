  .moments-tile-title { font-size: 11px; }
}

/* 「记录」tab 未开放：雏形页上盖灰色蒙版 + 期待上线点赞（utils/hubFlags.js recordsOpen=false） */
.records-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 50; background: rgba(48, 48, 48, .85); display: flex; align-items: center; justify-content: center; padding: 0 64rpx; }
.records-mask-content { display: flex; flex-direction: column; align-items: center; text-align: center; }
.records-mask-slogan { font-size: 40rpx; font-weight: 600; line-height: 1.5; color: #FFFFFF; letter-spacing: 1rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,.25); }
.records-mask-sub { margin-top: 16rpx; font-size: 26rpx; line-height: 1.5; color: rgba(255,255,255,.78); }
.records-like { margin-top: 64rpx; display: flex; align-items: center; gap: 14rpx; min-height: 44px; box-sizing: border-box; padding: 18rpx 44rpx 18rpx 36rpx; border-radius: 999rpx; background: rgba(255,255,255,.96); box-shadow: 0 8rpx 28rpx rgba(0,0,0,.18); }
.records-like-pressed { transform: scale(.96); }
.records-like-heart-wrap { position: relative; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; }
.records-like-heart { width: 48rpx; height: 48rpx; background-repeat: no-repeat; background-position: center; background-size: contain; }
.records-like-label { font-size: 30rpx; font-weight: 600; color: #333333; }
.records-like-count { font-size: 28rpx; font-weight: 600; color: #FF2442; min-width: 24rpx; }
.like-pop-a { animation: records-like-pop-a .45s cubic-bezier(.3,1.6,.5,1); }
.like-pop-b { animation: records-like-pop-b .45s cubic-bezier(.3,1.6,.5,1); }
@keyframes records-like-pop-a { 0% { transform: scale(1); } 30% { transform: scale(.7); } 65% { transform: scale(1.4); } 100% { transform: scale(1); } }
@keyframes records-like-pop-b { 0% { transform: scale(1); } 30% { transform: scale(.7); } 65% { transform: scale(1.4); } 100% { transform: scale(1); } }
.records-like-burst { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; }
.records-like-ring { position: absolute; left: -26rpx; top: -26rpx; width: 52rpx; height: 52rpx; box-sizing: border-box; border-radius: 50%; border: 3rpx solid #FF2442; opacity: 0; animation: records-like-ring .6s ease-out; }
@keyframes records-like-ring { 0% { transform: scale(.4); opacity: .9; } 100% { transform: scale(2.2); opacity: 0; } }
.records-like-spark { position: absolute; left: -9rpx; top: -9rpx; width: 18rpx; height: 18rpx; background-repeat: no-repeat; background-position: center; background-size: contain; opacity: 0; }
.spark-1 { animation: records-spark-1 .7s ease-out; } .spark-2 { animation: records-spark-2 .7s ease-out; }
.spark-3 { animation: records-spark-3 .7s ease-out; } .spark-4 { animation: records-spark-4 .7s ease-out; }
.spark-5 { animation: records-spark-5 .7s ease-out; } .spark-6 { animation: records-spark-6 .7s ease-out; }
@keyframes records-spark-1 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(0rpx,-64rpx) scale(1); opacity: 0; } }
@keyframes records-spark-2 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(56rpx,-32rpx) scale(1); opacity: 0; } }
@keyframes records-spark-3 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(56rpx,32rpx) scale(1); opacity: 0; } }
@keyframes records-spark-4 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(0rpx,64rpx) scale(1); opacity: 0; } }
@keyframes records-spark-5 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(-56rpx,32rpx) scale(1); opacity: 0; } }
@keyframes records-spark-6 { 0% { transform: translate(0,0) scale(.4); opacity: 1; } 100% { transform: translate(-56rpx,-32rpx) scale(1); opacity: 0; } }
.records-like-plus { position: absolute; left: 10rpx; top: -40rpx; font-size: 26rpx; font-weight: 700; color: #FF2442; opacity: 0; white-space: nowrap; animation: records-like-plus .8s ease-out; }
@keyframes records-like-plus { 0% { transform: translateY(0) scale(.6); opacity: 0; } 25% { opacity: 1; transform: translateY(-10rpx) scale(1.1); } 100% { transform: translateY(-56rpx) scale(1); opacity: 0; } }
