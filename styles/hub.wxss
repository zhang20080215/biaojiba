.timeline-items { display: flex; flex-direction: column; gap: 0; background: var(--bg-section); border-radius: 14rpx; padding: 0 16rpx; }
.timeline-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.timeline-item image { flex-shrink: 0; width: 64rpx; height: 84rpx; border-radius: 8rpx; }
