/*
  Global theme tokens — 通用型浅灰白主题
  Source of truth: style.md v2.2.0
  Usage: @import "./styles/theme.wxss"; in app.wxss
*/

page {
  /* ---- 基础色板 ---- */
  --bg-page: #FAFAFA;
  --bg-section: #F5F5F4;
  --bg-card: #FFFFFF;

  --text-primary: #2D2D2B;
  --text-secondary: #6F6F68;
  --text-muted: #9C998F;

  /* 默认主题：粉色 */
  --brand-primary: #FAE0E4;
  --brand-soft: #FFB2DD;
  /* brand-primary/soft 是浅色，只适合大面积底色和装饰；压在它们上面的字和控件用下面四个同色相的深浅层：
     accent  进度条、强调数字、勾选框等小面积强调（与首页四个 tab 的强调色同值）
     tint    浅底（选中背景、轻提示块）
     hero-ink  浅色头图上的标题
     hero-soft 浅色头图上的标语、小字 —— 实色中间调，不要用深色叠透明度，那样会混出灰脏色 */
  --brand-accent: #93415E;
  --brand-tint: #F9EDF1;
  /* 主按钮、选中 tab 的底色：沿用线上主题色，配 hero-ink 深字（不用白字，浅底上看不清） */
  --brand-button: #FAE0E4;
  /* 头图与内容页整页底色（首页 hub-hero、豆瓣 TOP250 页）。三套等于主色；暖沙见下 */
  --brand-hero: #FAE0E4;
  --hero-ink: #5E2539;
  --hero-soft: #9A6378;

  --success: #9AAB65;
  --success-soft: #E1E6D1;

  --info: #B6CAEB;
  --info-soft: #EAF0F9;

  --warning: #F7D66E;
  --warning-soft: #FEEFBF;

  --line-subtle: #EAEAE7;

  /* ---- 字号层级 ---- */
  --font-display: 48rpx;
  --font-h1: 40rpx;
  --font-h2: 32rpx;
  --font-title: 30rpx;
  --font-body: 26rpx;
  --font-caption: 22rpx;
  --font-mini: 20rpx;

  /* ---- 间距 8pt ---- */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;

  /* ---- 圆角 ---- */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-pill: 9999rpx;

  /* ---- 阴影 ---- */
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-float: 0 6rpx 20rpx rgba(0, 0, 0, 0.10);
  --shadow-cta: 0 6rpx 14rpx rgba(255, 178, 221, 0.28);
}

/* ---- 主题 A：暖金 ---- */
page.theme-gold,
.page-root.theme-gold {
  --brand-primary: #F7D66E;
  --brand-soft: #FEEFBF;
  --brand-accent: #7B5918;
  --brand-tint: #FBF3DE;
  --brand-button: #F7D66E;
  --brand-hero: #F7D66E;
  --hero-ink: #553A0B;
  --hero-soft: #85621F;
  --shadow-cta: 0 6rpx 14rpx rgba(247, 214, 110, 0.28);
}

/* ---- 主题 B：橄榄绿 ---- */
page.theme-green,
.page-root.theme-green {
  --brand-primary: #9AAB65;
  --brand-soft: #9AAB65;
  --brand-accent: #526631;
  --brand-tint: #EEF2E5;
  --brand-button: #9AAB65;
  --brand-hero: #9AAB65;
  /* 头图底色本身是中绿，文字要比其他三套更深才压得住 */
  --hero-ink: #1F2B12;
  --hero-soft: #34421B;
  --shadow-cta: 0 6rpx 14rpx rgba(154, 171, 101, 0.28);
}

/* ---- 主题 C：暖沙 ---- */
page.theme-sand,
.page-root.theme-sand {
  --brand-primary: #F8F3E7;
  --brand-soft: #EDE7DA;
  --brand-accent: #756044;
  --brand-tint: #F4EFE6;
  /* 暖沙主色 #F8F3E7 几乎是白色：头图改用它自己的 brand-soft #EDE7DA 才像一块头图；
     按钮压在头图同色系上，再深一档 #E2DACB，否则和头图融在一起 */
  --brand-hero: #EDE7DA;
  --brand-button: #E2DACB;
  --hero-ink: #4A3D2A;
  --hero-soft: #8A7A62;
  --shadow-cta: 0 6rpx 14rpx rgba(237, 231, 218, 0.28);
}

/* ---------- Global primitives ---------- */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-primary);
  box-sizing: border-box;
}

.surface {
  background: var(--bg-section);
  border-radius: var(--radius-lg);
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  box-shadow: var(--shadow-card);
}

.elevated {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-float);
}

/* ---------- Typography ---------- */
.text-display {
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.2;
  color: var(--text-primary);
}

.section-title {
  font-size: var(--font-h2);
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-primary);
}

.text-title {
  font-size: var(--font-title);
  font-weight: 600;
  line-height: 1.2;
}

.text-body {
  font-size: var(--font-body);
  font-weight: 400;
  line-height: 1.45;
  color: var(--text-secondary);
}

.text-caption {
  font-size: var(--font-caption);
  font-weight: 400;
  line-height: 1.4;
  color: var(--text-muted);
}

.divider {
  width: 100%;
  height: 1rpx;
  background: var(--line-subtle);
}

/* ---------- Buttons ---------- */
.btn-primary {
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: var(--text-primary);
  font-size: var(--font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-cta);
  transition: transform 120ms ease-out;
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary--disabled {
  opacity: 0.45;
}

.btn-secondary {
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-soft);
  color: var(--text-primary);
  font-size: var(--font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease-out;
}

.btn-secondary:active {
  transform: scale(0.98);
}

.btn-ghost {
  height: 76rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-subtle);
  color: var(--text-primary);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- Chips / Tags ---------- */
.chip {
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-mini);
  line-height: 1;
}

.chip--brand {
  background: var(--brand-soft);
  color: var(--text-primary);
}

.chip--success {
  background: var(--success-soft);
  color: #44522C;
}

.chip--info {
  background: var(--info-soft);
  color: #27405F;
}

.chip--warning {
  background: var(--warning-soft);
  color: #5E4A13;
}

/* ---------- Utility spacing ---------- */
.mt-1 { margin-top: var(--space-1); }
.mt-2 { margin-top: var(--space-2); }
.mt-3 { margin-top: var(--space-3); }
.mt-4 { margin-top: var(--space-4); }
.mb-1 { margin-bottom: var(--space-1); }
.mb-2 { margin-bottom: var(--space-2); }
.mb-3 { margin-bottom: var(--space-3); }
.mb-4 { margin-bottom: var(--space-4); }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }

/* ---------- Motion baseline ---------- */
.interactive {
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

.interactive:active {
  transform: scale(0.98);
}
